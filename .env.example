PORT=5000
NODE_ENV=development

# Local MongoDB (matches a local MongoDB Compass / mongod install)
MONGO_URI=mongodb://127.0.0.1:27017/customer_vehicle_management

# Change this to a long random string in production
JWT_SECRET=replace-this-with-a-long-random-secret
JWT_EXPIRES_IN=1d
JWT_REMEMBER_EXPIRES_IN=30d

# Login cookie lifetime in milliseconds (default vs "Remember for 30 days")
SESSION_MAX_AGE_MS=86400000
SESSION_REMEMBER_MAX_AGE_MS=2592000000

# How many devices/browsers can be logged in at once for the admin account.
# Logging in beyond this signs out the oldest active session(s). Set to 1 for the
# original "single device only" behavior.
MAX_ACTIVE_SESSIONS=1

# Origin allowed to call the API with credentials
CLIENT_ORIGIN=http://localhost:5173

# Optional. The admin account itself is created manually (e.g. directly in the database) —
# not by this app. If both of these are set, the existing admin's credentials are synced to
# match them on every startup (a way to rotate credentials without a change-password route).
# Leave unset to leave the manually-created admin untouched.
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=ChangeMe123!

# Online booking from the customer site ("Book a Car"). Off unless set to true — trips are booked by
# the team from the admin portal. Turn it on together with VITE_ENABLE_BOOKING on the customer site.
# ENABLE_PORTAL_BOOKING=false

# File storage (vehicle photos, vehicle documents, customer documents) — a private S3 bucket.
# Uploads fail with a clear error until these are set. The IAM user needs s3:PutObject and
# s3:GetObject on arn:aws:s3:::<bucket>/*. Files uploaded before S3 was introduced are moved with
# `npm run migrate:s3` (add `-- --dry` to only count them).
S3_BUCKET=
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional folder inside the bucket (e.g. production / staging).
# S3_PREFIX=
# How long (seconds) the file links the admin portal gets stay valid. Default 3600.
# S3_SIGNED_URL_TTL_SECONDS=3600

# Nightly report engine (Reports page in the admin portal). On Vercel it runs from vercel.json's cron
# (18:35 UTC = 00:05 IST), which calls GET /api/reports/cron with "Authorization: Bearer <CRON_SECRET>"
# — set CRON_SECRET in the Vercel project (Vercel sends it automatically). When the API runs as a
# normal server (npm start / npm run dev) it schedules itself at REPORT_RUN_TIME business time.
CRON_SECRET=replace-with-a-long-random-string
# REPORT_RUN_TIME=00:05
# REPORT_SCHEDULER=off
# Automatic retries per metric when a run fails (0-5). Default 5.
# REPORT_MAX_RETRIES=5
# How many days back each nightly run refreshes (1 = only the day that just ended). Default 1.
# REPORT_LOOKBACK_DAYS=1

# Email (welcome email to newsletter subscribers) — any SMTP provider: Gmail / Google Workspace with an
# app password (smtp.gmail.com, 465), Zoho (smtp.zoho.in, 465), Brevo (smtp-relay.brevo.com, 587),
# Amazon SES SMTP, ... Without SMTP_HOST nothing is sent (in development the email is printed in the log).
# SMTP_HOST=
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM="RoamWheels <hello@yourdomain.com>"
# Customer site address used for links and the logo in emails.
# SITE_URL=https://customer-vehicle-management-user.vercel.app
